# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — the .example variant is a template of placeholder
# values only (safe, was previously committed), but keeping both env
# files out of git entirely removes any temptation to ever paste a
# real value into a tracked file.
.env*.local
.env
.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase
supabase/.branches
supabase/.temp

# raw source photography — already uploaded/processed into Supabase
# Storage; these are large binary originals, not something a git
# history needs to carry.
/assets
