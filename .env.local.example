# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already in .gitignore.

# ---- Supabase — public (safe to expose to the browser bundle) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase — SERVER ONLY. Never prefix with NEXT_PUBLIC_. ----
# Used only in lib/supabase/admin.ts, which is only imported from
# app/api/** route handlers and admin server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Supabase — SERVER ONLY, one-time use. Needed only so
# migrations can be run programmatically (a direct Postgres
# connection to run supabase/migrations/*.sql). The app itself never
# reads this at runtime — it's not imported by any app code, only
# used by a one-off setup script. Find it in the Supabase dashboard:
# Settings -> Database -> Connection string -> URI (use the
# "Session pooler" string if the direct one is IPv6-only). Safe to
# rotate the DB password afterward if you'd rather not leave it live.
SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres

# ---- Razorpay — TEST MODE for now. Put the Test Mode Key ID/Secret
# in these same two variables during development; switching to Live
# Mode later is a matter of replacing these values with the Live Mode
# credentials, nothing in the code changes. No separate test/
# production variable pair.

# Public key id — safe to expose client-side, used to open Razorpay Checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ — must never reach the browser.
RAZORPAY_KEY_SECRET=your_test_key_secret

# ---- Razorpay webhook — SERVER ONLY. Backstop for when a payment
# succeeds but the browser never completes the client-side verify
# call (tab closed, network drop). Get this value from the Razorpay
# Dashboard -> Settings -> Webhooks, after creating a webhook pointed
# at https://<your-deployed-domain>/api/payments/webhook subscribed
# to at least payment.captured and payment.failed. Until this is set,
# the webhook route safely rejects every delivery rather than
# processing anything unverified.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ---- App ----
# Local dev URL only. The project owner configures the production
# value in Vercel's environment settings — do not put a deployment
# URL here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
